# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets. `*.local` already covers .env.local, which is what Vite reads —
# but a bare `.env` was NOT ignored, and this repo is public. One `git add -A`
# with a service_role key sitting in .env would publish it irreversibly.
.env
.env.*
!.env.example

# Personal financial data — never commit real transaction exports/imports
*.csv
# Real state blobs exported for pre-migration verification (scripts/export_blobs.mjs).
# Same rule as *.csv: four people's complete financial history, never in the repo.
.blobs/

# Expo client build/cache output. `node_modules` above already covers
# mobile/node_modules; these are the rest.
mobile/.expo/
mobile/dist/
mobile/ios/
mobile/android/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Throwaway browser-verification harness (created per session, deleted after).
# Belt and braces: teardown removes these, and this makes sure a missed
# teardown can never commit one.
mobile-preview.html
src/mobile-preview-entry.jsx
.tmp-*.mjs

# THE PERSONAL TERM LIST, and the most important line in this file.
# `.personal-terms` is what scripts/check_personal.mjs greps tracked
# files for: bank names, account names, real balances, the names of
# people in this person's life. A committed list of things that must
# never be committed is the thing it exists to prevent — it would put
# all of them in one convenient file, for ever. It stays local, every
# machine keeps its own, and the check skips quietly where there is
# none. Never remove this line.
.personal-terms

# The App Store demo account, written by scripts/demo_account.mjs.
# Regenerable and dated relative to the day it is made, so a committed
# copy would go stale the way the hand-taken landing screenshots did.
demo-account.json
