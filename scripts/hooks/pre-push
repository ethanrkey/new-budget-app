#!/bin/sh
# Spelling gate over the COMMIT MESSAGES being pushed.
#
# The file gate (npm test) never saw commit messages, and that is exactly
# where the rule kept breaking — three times in one day, once inside the
# commit that hardened the rule. Install with `npm run hooks:install`.
#
# git feeds pre-push one line per ref: <local-ref> <local-sha> <remote-ref> <remote-sha>
# A remote sha of all zeros means the remote has no such branch yet.
NULL=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$NULL" ] && continue          # deleting a branch
  if [ "$remote_sha" = "$NULL" ]; then
    range="$local_sha --not --remotes"            # a new branch: its own commits only
  else
    range="$remote_sha..$local_sha"
  fi
  node scripts/check_spelling.mjs --messages "$range" || status=1
done

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Push refused: American spelling, in commit messages too (rule 1a)."
  echo "Reword with 'git commit --amend' or 'git rebase -i', then push again."
  echo "To override once: git push --no-verify"
fi
exit $status
