{
  // Type-checking only. Vite transpiles for the browser and Node 24 strips
  // types for the test harness, so tsc never emits anything here — it is a
  // linter for types and nothing else.
  //
  // Scope is src/engine plus its direct consumers' imports. The components
  // stay JSX on purpose (see PROJECT_SPEC "JavaScript / TypeScript boundary"):
  // the engine is where the money math and the shared-with-iOS contract live,
  // and typing it is most of the value.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,

    "noEmit": true,
    // Intra-engine imports carry explicit .ts extensions so the same specifier
    // resolves under Vite, tsc, AND plain Node's type stripping — Node does no
    // TypeScript-style resolution, so "./model.js" would simply not exist.
    "allowImportingTsExtensions": true,

    // The engine is mid-migration: .ts and .js files import each other, and
    // the .js ones are not type-checked yet.
    "allowJs": true,
    "checkJs": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // The non-JSX JS files are in scope and carry `// @ts-check`, so a bad
  // call into the typed engine from them is a compile error. storage.js and
  // App.jsx are deliberately still out: measured at 25 and (untried) many
  // implicit-any complaints under `strict`, which is noise rather than bugs.
  // See the decision log for what covers those two instead.
  "include": [
    "src/engine/**/*",
    "src/auth.js", "src/theme.js", "src/devicePrefs.js",
    "src/downloadFile.js", "src/supabase.js"
  ]
}
