{
  "expo": {
    "name": "Key Budget",
    "slug": "key-budget",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b1d6b66c-3cf8-4316-a200-201891c947ce",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keybudget",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.keybudget",
      "icon": "./assets/images/KeyBudget.icon",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      "expo-sharing",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.225819918731-h8uii8j71melja4strfhfvvnlcc4pnsf"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b1d6b66c-3cf8-4316-a200-201891c947ce"
      }
    },
    "owner": "ethankey"
  }
}
